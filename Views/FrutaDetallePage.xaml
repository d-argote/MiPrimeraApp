<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MiPrimeraApp.ViewModels"
             x:Class="MiPrimeraApp.Views.FrutaDetallePage"
             x:DataType="viewmodels:FrutaDetalleViewModel"
             Title="Detalle de Fruta"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header con color de la fruta -->
            <Grid BackgroundColor="{Binding ColorHex}" Padding="20,30" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                <Frame Grid.RowSpan="2"
                       WidthRequest="80" HeightRequest="80"
                       CornerRadius="40"
                       Padding="0"
                       HasShadow="False"
                       BorderColor="White"
                       BackgroundColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Emoji}" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding NombreFruta}"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="White"
                       Margin="16,0,0,0"
                       VerticalOptions="End"/>
                <Label Grid.Row="1" Grid.Column="1"
                       Text="Detalle de la fruta"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.9"
                       Margin="16,2,0,0"
                       VerticalOptions="Start"/>
            </Grid>

            <!-- Card Descripción Actual -->
            <Frame Margin="16,16,16,0" Padding="16" CornerRadius="14" HasShadow="True" BorderColor="#E0E0E0" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Descripción actual" FontSize="13" FontAttributes="Bold" TextColor="#512BD4" />
                    <BoxView HeightRequest="1" Color="#EDE7F6"/>
                    <!-- Bindeado a DescripcionFruta del ViewModel Toolkit. Al Guardar, se actualiza y se ve arriba -->
                    <Label Text="{Binding DescripcionFruta}"
                           FontSize="15"
                           TextColor="#212121"
                           LineHeight="1.3"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Editor para cambiar descripción -->
            <Frame Margin="16,16,16,0" Padding="16" CornerRadius="14" HasShadow="True" BorderColor="#E0E0E0" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Editar descripción" FontSize="13" FontAttributes="Bold" TextColor="#512BD4" />
                    <BoxView HeightRequest="1" Color="#EDE7F6"/>

                    <Border Stroke="#BDBDBD" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8" BackgroundColor="#FAFAFA">
                        <Editor Text="{Binding NuevaDescripcion}"
                                Placeholder="Escribe la nueva descripción..."
                                AutoSize="TextChanges"
                                FontSize="15"
                                TextColor="#212121"
                                PlaceholderColor="#9E9E9E"
                                MinimumHeightRequest="100"/>
                    </Border>

                    <Label Text="{Binding MensajeEstado}"
                           FontSize="13"
                           TextColor="#2E7D32"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Volver"
                                Command="{Binding VolverCommand}"
                                BackgroundColor="#E0E0E0"
                                TextColor="#424242"
                                CornerRadius="12"
                                HeightRequest="48"/>
                        <Button Grid.Column="1"
                                Text="Guardar"
                                Command="{Binding GuardarCommand}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"/>
                    </Grid>

                    <Label Text="Al guardar, la descripción se actualiza en el ViewModel y se refleja arriba y en la lista al volver."
                           FontSize="11" TextColor="#9E9E9E" HorizontalTextAlignment="Center" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
