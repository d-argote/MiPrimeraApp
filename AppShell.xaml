<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MiPrimeraApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MiPrimeraApp"
    Title="MiPrimeraApp">

    <!-- TabBar con dos pestañas -->
    <TabBar>
        <ShellContent
            Title="Inicio"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Frutas"
            ContentTemplate="{DataTemplate local:FrutasPage}"
            Route="FrutasPage" />
    </TabBar>

</Shell>
